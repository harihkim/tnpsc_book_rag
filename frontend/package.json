{
  "name": "tnpsc-book-rag-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SvelteKit 2 + Svelte 5 frontend for the TNPSC Book RAG backend (landing page + RAG app workspace).",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate:api": "openapi-typescript ../openapi.v1.yaml -o src/lib/api/v1.generated.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.0",
    "@types/three": "^0.180.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^1.0.0",
    "@hugeicons/svelte": "^1.0.0",
    "@threlte/core": "^8.5.0",
    "bits-ui": "^1.3.0",
    "gsap": "^3.13.0",
    "lenis": "^1.1.20",
    "openapi-fetch": "^0.13.5",
    "three": "^0.180.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
