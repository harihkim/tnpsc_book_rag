# Deterministic defaults for the automated test environment.
TNPSC_ENVIRONMENT=test
TNPSC_DEBUG=false
TNPSC_SERVICE_NAME=tnpsc-book-rag-api-test
TNPSC_API_HOST=127.0.0.1
TNPSC_API_PORT=8001
# Unit tests leave this unset. PostgreSQL integration tests use TNPSC_TEST_DATABASE_URL explicitly.
TNPSC_DATABASE_URL=
TNPSC_TEST_DATABASE_URL=
TNPSC_DATABASE_POOL_SIZE=2
TNPSC_DATABASE_MAX_OVERFLOW=0
TNPSC_DATABASE_CONNECT_TIMEOUT_SECONDS=2
TNPSC_ARTIFACT_ROOT=artifacts-test
TNPSC_CORS_ORIGINS=[]
TNPSC_MAX_UPLOAD_BYTES=52428800
TNPSC_MAX_QUERY_CHARACTERS=1000
TNPSC_MAX_TOP_K=50
TNPSC_MAX_ANSWER_CHARACTERS_PER_SECTION=8000
TNPSC_ANSWER_TIMEOUT_SECONDS=60
TNPSC_ANSWER_RETENTION_SECONDS=86400
TNPSC_IDEMPOTENCY_RETENTION_SECONDS=86400
TNPSC_INGESTION_POLL_AFTER_SECONDS=2
TNPSC_WORKER_HEARTBEAT_PATH=/tmp/tnpsc-book-rag-worker-test.heartbeat.json
TNPSC_WORKER_HEARTBEAT_INTERVAL_SECONDS=0.5
TNPSC_WORKER_HEARTBEAT_STALE_AFTER_SECONDS=2
TNPSC_THUMBNAIL_MAX_EDGE_PIXELS=640
TNPSC_LOG_LEVEL=WARNING
TNPSC_OTEL_ENABLED=true
TNPSC_OTEL_SAMPLE_RATIO=1.0
TNPSC_OTEL_TRACES_ENDPOINT=

# Provider keys intentionally remain empty so tests cannot make real model calls.
TNPSC_GROQ_API_KEY=
TNPSC_OPENROUTER_API_KEY=
TNPSC_MISTRAL_API_KEY=
