# Local development settings. Copy this file to .env and adjust as needed.
TNPSC_ENVIRONMENT=development
TNPSC_DEBUG=true
TNPSC_SERVICE_NAME=tnpsc-book-rag-api
TNPSC_API_HOST=127.0.0.1
TNPSC_API_PORT=8000
TNPSC_DATABASE_URL=postgresql://tnpsc:tnpsc@localhost:5432/tnpsc
TNPSC_ARTIFACT_ROOT=artifacts
TNPSC_CORS_ORIGINS=["http://localhost:5173"]
TNPSC_LOG_LEVEL=DEBUG
TNPSC_OTEL_ENABLED=true
TNPSC_OTEL_SAMPLE_RATIO=1.0
# Add /v1/traces when sending directly to an OTLP/HTTP collector.
TNPSC_OTEL_TRACES_ENDPOINT=

# Optional free-tier provider credentials. Never commit real values.
TNPSC_GROQ_API_KEY=
TNPSC_OPENROUTER_API_KEY=
TNPSC_MISTRAL_API_KEY=
