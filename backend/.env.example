# Local development settings. Copy this file to .env and adjust as needed.
TNPSC_ENVIRONMENT=development
TNPSC_DEBUG=true
TNPSC_SERVICE_NAME=tnpsc-book-rag-api
TNPSC_API_HOST=127.0.0.1
TNPSC_API_PORT=8000
TNPSC_DATABASE_URL=postgresql+psycopg://tnpsc:tnpsc@localhost:55432/tnpsc
TNPSC_DATABASE_POOL_SIZE=5
TNPSC_DATABASE_MAX_OVERFLOW=5
TNPSC_DATABASE_CONNECT_TIMEOUT_SECONDS=5
TNPSC_ARTIFACT_ROOT=artifacts
# Optional read-only directory of verified package-v2 ZIPs. Keep only one
# chunking variant per source PDF in this directory.
TNPSC_EXTRACTION_PACKAGE_INBOX=data_extraction_v2/6th_v3_256
TNPSC_CORS_ORIGINS=["http://localhost:5173"]

# Managed OpenID Connect authentication. Production refuses to start without it.
TNPSC_AUTH_ENABLED=false
TNPSC_OIDC_ISSUER=
TNPSC_OIDC_AUDIENCE=
TNPSC_OIDC_JWKS_URL=
TNPSC_OIDC_ALGORITHMS=["RS256"]
TNPSC_OIDC_ROLES_CLAIM=roles
TNPSC_OIDC_SCOPES_CLAIM=scope

# Shared Redis/Valkey enforcement. Use rediss:// in production.
TNPSC_RATE_LIMITING_ENABLED=false
TNPSC_RATE_LIMIT_URL=
TNPSC_RATE_LIMIT_IP_HMAC_SECRET=
TNPSC_MAX_UPLOAD_BYTES=52428800
TNPSC_MAX_QUERY_CHARACTERS=1000
TNPSC_MAX_TOP_K=50
TNPSC_MAX_ANSWER_CHARACTERS_PER_SECTION=8000
TNPSC_ANSWER_TIMEOUT_SECONDS=60
TNPSC_ANSWER_RETENTION_SECONDS=86400
TNPSC_IDEMPOTENCY_RETENTION_SECONDS=86400
TNPSC_INGESTION_POLL_AFTER_SECONDS=2
TNPSC_ASSET_UPLOAD_CONCURRENCY=8
TNPSC_WORKER_POLL_SECONDS=2
TNPSC_DOCLING_DEVICE=auto
TNPSC_WORKER_HEARTBEAT_PATH=run/worker-heartbeat.json
TNPSC_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
TNPSC_WORKER_HEARTBEAT_STALE_AFTER_SECONDS=20
TNPSC_THUMBNAIL_MAX_EDGE_PIXELS=640
TNPSC_LOG_LEVEL=DEBUG
TNPSC_OTEL_ENABLED=true
TNPSC_OTEL_SAMPLE_RATIO=1.0
# Add /v1/traces when sending directly to an OTLP/HTTP collector.
TNPSC_OTEL_TRACES_ENDPOINT=

# Embedding model configuration (Phase 2)
TNPSC_EMBEDDING_MODEL_IDENTIFIER=BAAI/bge-small-en-v1.5
TNPSC_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
TNPSC_EMBEDDING_BATCH_SIZE=32
TNPSC_EMBEDDING_DEVICE=auto

# Context assembly configuration (Phase 3)
TNPSC_CONTEXT_TOKEN_BUDGET=3000

# LLM provider configuration (Phase 4)
# Provider: openrouter (default), groq, or mistral
TNPSC_LLM_PROVIDER=openrouter
# OpenRouter free models: https://openrouter.ai/models?order=pricing&supported_parameters=tools
TNPSC_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
TNPSC_LLM_FALLBACK_MODEL=nvidia/nemotron-nano-9b-v2:free

# Optional free-tier provider credentials. Never commit real values.
TNPSC_GROQ_API_KEY=
TNPSC_OPENROUTER_API_KEY=
TNPSC_MISTRAL_API_KEY=
